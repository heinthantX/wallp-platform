# Environment: development | production | test
APP_ENV=development

# HTTP listen address
HTTP_ADDR=:8080

# Database URL: Postgres or SQLite
# SQLite alternative: file:./data/wallp.db
DATABASE_URL=postgres://wallp:wallp@localhost:5433/wallp?sslmode=disable

# JWT signing secret (min 32 characters)
JWT_SECRET=change-me-to-a-secure-secret-with-at-least-32-chars

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Issuer name shown in authenticator apps (TOTP)
TOTP_ISSUER=wallp

# Allowed CORS origins for Admin UI (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Directory for catalog releases and uploaded media assets
STORAGE_DIR=./data/storage

# Public URL used in links (QR preview, asset URLs)
PUBLIC_BASE_URL=http://localhost:8080

# Required in production to create the first admin over HTTP
SETUP_TOKEN=

# Auth rate limit: requests per minute per IP on auth endpoints
AUTH_RATE_LIMIT=20

# Optional AI providers (docs/specs/ai-creation.md). Empty = off; endpoints answer 501 ai_not_configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
GEMINI_API_KEY=
